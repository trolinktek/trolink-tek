    "build": "next build",
    "start": "next start --hostname 0.0.0.0"
  },
  "dependencies": {
    "next": "^15.5.9",
    "nodemailer": "^7.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
