{
  "name": "trolink-tek",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "site:sync": "node scripts/prepare-next-site.mjs",
    "predev": "npm run seo:sitemap && npm run site:sync",
    "dev": "next dev --hostname 127.0.0.1",
